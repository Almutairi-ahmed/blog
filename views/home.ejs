<%- include("partials/header") -%>

<div class="post">
    <h1 class="post-title">Welcome to DarkBlog</h1>
    <div class="post-meta">Published on <%= new Date().toLocaleDateString() %></div>
    <div class="post-content">
        <p>Welcome to your new dark-themed blog! Start by creating some posts using the Compose page.</p>
    </div>
    <span class="btn btn-disabled">Static Post</span>
</div>

<div class="post">
    <h1 class="post-title">Getting Started with Dark Mode</h1>
    <div class="post-meta">Published on <%= new Date().toLocaleDateString() %></div>
    <div class="post-content">
        <p>Dark mode reduces eye strain and saves battery life on OLED screens.</p>
        <p>Learn how we implemented this sleek dark theme using CSS variables.</p>
    </div>
    <span class="btn btn-disabled">Static Post</span>
</div>
<% posts.forEach(function(post){ %>
<div class="post">
    <h1 class="post-title"><%= post.Titles %></h1>
    <div class="post-meta">Published on <%= new Date().toLocaleDateString() %></div>
    <div class="post-content">
        <p class="post-preview"><%= post.conten.slice(0, 50) %><%=post.conten.length > 50 ? " ..." : "" %></p>
    </div>
    <a href="/post/<%= post.slug %>" class="btn">Read More</a>
    
    
</div>
<% }); %>

<%- include("partials/footer") -%>